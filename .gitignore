# Node
node_modules/

# Environment: real values never committed; .env.example lists names only
.env
.env.*
!.env.example

# Data files
*.json
!package.json
!package-lock.json
!tsconfig.json
!frontend/public/data/analytical_breakdowns.json
!frontend/public/data/learning_resources.json
!backend/data/analytical_breakdowns.json
!backend/data/learning_resources.json
# Inputs to generate_index.py (hand fixes + exact choices read from the exam PDFs)
!backend/data/choice_map.json
!backend/data/choice_overrides.json
!backend/data/content_overrides.json
!backend/data/kind_overrides.json
# Question bank + sorting/catalog data the deployed app needs (no user data)
!frontend/public/data/questions_index.json
!frontend/public/data/metadata_summary.json
!frontend/public/image-list.json
!frontend/public/manifest.json
!vercel.json

# Personal / user data: never commit, even if an allowlist above is widened later
backend/data/user_stats.json
**/slackr_*export*.json
**/slackr_*backup*.json
**/slackr_stats_*.json


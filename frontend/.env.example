# Copy to frontend/.env.local for local development. Never commit real values.
# Only VITE_* variables are bundled into the browser app: never put a secret
# (such as the Supabase service-role key) in a VITE_* variable.

# Online accounts, sync and bug reports are handled by the FastAPI backend (see backend/.env.example).
# Nothing about Supabase belongs in this file.

# FastAPI origin. Leave empty for same-origin /api (Vercel, or the Vite dev proxy below).
VITE_API_BASE_URL=

# Dev server only: where `bun run dev` proxies /api. Defaults to http://127.0.0.1:8000.
API_PROXY_TARGET=

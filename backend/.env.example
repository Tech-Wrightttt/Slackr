# FastAPI server settings. On Vercel, set these in Project Settings -> Environment Variables.
# Never commit real values and never expose these to the frontend.

# Copy to backend/.env for local runs (git-ignored; loaded by main.py). On Vercel, set these as
# Environment Variables instead. Leave empty and online accounts are simply turned off.

# Supabase project URL and publishable/anon key, used server-side only (accounts, backup, bug reports).
# Never add the secret / service-role key: SLACKR doesn't need it.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional: lets people sign in with their username on a new device. Value comes from
# supabase/migrations/0003_username_sign_in.sql (select value from private.app_config ...). Keep it secret.
SUPABASE_LOGIN_LOOKUP_KEY=

# Admin token required to save learning resources / analytical breakdowns.
# Unset locally = editing open on your machine. Unset when hosted = editing disabled.
SLACKR_ADMIN_TOKEN=

# Comma-separated origins allowed to call the API cross-origin. Same-origin needs nothing.
ALLOWED_ORIGINS=

# Force hosted mode outside Vercel (1 = on). Vercel sets VERCEL automatically.
SLACKR_HOSTED=

# Optional override for the local single-user stats file.
SLACKR_STATS_PATH=
